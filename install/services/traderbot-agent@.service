# TraderBot Agent Systemd Service Template
#
# System-level service that starts at boot (no login required).
# Uses %i as the instance/username for the agent.
#
# USAGE:
#   install-service.sh <agent_name> <profile_token>
#
# The installer replaces <PROFILE_TOKEN> and adjusts paths.
# VENV_PATH: /home/%i/traderbot/.venv/bin/traderbot
# CONFIG_DIR: /home/%i/.traderbot/

[Unit]
Description=TraderBot Agent (%i)
Documentation=https://github.com/JsonDaRula69/TraderBot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/traderbot

Environment=TRADERBOT_PROFILE_TOKEN=<PROFILE_TOKEN>
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/%i/traderbot/.venv/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/bin/bash -c 'while true; do /home/%i/traderbot/.venv/bin/traderbot heartbeat; sleep 300; done'

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=traderbot-agent-%i

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/traderbot /home/%i/.traderbot

[Install]
WantedBy=multi-user.target