# TraderBot Agent Systemd Service Template
#
# System-level service that starts at boot (no login required).
# Uses %i as the instance/username for the agent.
#
# USAGE:
#   install-service.sh <agent_name>
#
# This service runs a single healthcheck on boot to verify that the
# TraderBot agent profile and Kalshi API credentials are configured.
# Scheduling is handled by OpenClaw Gateway (cron loops), not this service.
#
# The installer creates ~/.traderbot/.env with the profile token.
# VENV_PATH: /home/%i/traderbot/.venv/bin/traderbot
# CONFIG_DIR: /home/%i/.traderbot/

[Unit]
Description=TraderBot Agent Healthcheck (%i)
Documentation=https://github.com/JsonDaRula69/TraderBot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/traderbot

EnvironmentFile=%h/.traderbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/%i/traderbot/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Run a single heartbeat healthcheck to verify profile and credentials.
# Scheduling (decision loop, heartbeat, news) is managed by OpenClaw Gateway.
ExecStart=/home/%i/traderbot/.venv/bin/traderbot heartbeat --dry-run --json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=traderbot-agent-%i

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/traderbot /home/%i/.traderbot

[Install]
WantedBy=multi-user.target