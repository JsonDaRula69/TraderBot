# TraderBot Data Backfill Systemd Service (one-shot)
#
# Runs traderbot backfill to fetch historical weather (Open-Meteo) and
# economic (FRED) data into the ChromaDB data_points collection. Designed
# to be triggered by a timer for daily incremental updates.
# Idempotent — skips already-stored doc IDs on each run.
#
# USAGE:
#   systemctl start traderbot-backfill-data@<username>
#   systemctl enable --now traderbot-backfill-data@<username>.timer
#
# VENV_PATH: /home/%i/traderbot/.venv/bin/traderbot
# CONFIG_DIR: /home/%i/.traderbot/

[Unit]
Description=TraderBot Data Backfill (%i)
Documentation=https://github.com/JsonDaRula69/TraderBot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/traderbot

EnvironmentFile=/home/%i/.traderbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/%i/traderbot/.venv/bin:/usr/local/bin:/usr/bin:/bin

# --months 1: daily incremental. Idempotent — skips duplicates.
ExecStart=/home/%i/traderbot/.venv/bin/traderbot backfill --months 1 --json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=traderbot-backfill-%i

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
