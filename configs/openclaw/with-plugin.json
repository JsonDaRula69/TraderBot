{
  "plugins": {
    "load": {
      "paths": [
        "plugins/traderbot-token-injector"
      ]
    },
    "entries": {
      "traderbot-token-injector": {
        "config": {
          "agentTokenMap": {
            "weather": {
              "source": "exec",
              "provider": "infisical",
              "id": "weather_token"
            },
            "sysadmin": {
              "source": "exec",
              "provider": "infisical",
              "id": "sysadmin_token"
            },
            "dev-liaison": {
              "source": "exec",
              "provider": "infisical",
              "id": "dev-liaison_token"
            }
          }
        }
      }
    }
  },
  "secrets": {
    "providers": {
      "infisical": {
        "type": "exec",
        "command": "/usr/local/bin/openclaw-infisical-resolver",
        "args": [],
        "passEnv": [
          "INFISICAL_TOKEN",
          "INFISICAL_DOMAIN"
        ],
        "jsonOnly": true
      }
    }
  },
  "mcp": {
    "servers": {
      "traderbot": {
        "command": "traderbot-mcp-server",
        "transport": "stdio",
        "env": {
          "TRADERBOT_USE_HARDCODED_AUTH": "0"
        }
      }
    }
  }
}
