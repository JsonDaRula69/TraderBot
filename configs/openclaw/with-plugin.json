{
  "plugins": {
    "load": {
      "paths": [
        "plugins/traderbot-token-injector"
      ]
    },
    "entries": {
      "traderbot-token-injector": {
        "config": {
          "agentTokenMap": {
            "weather": {
              "source": "exec",
              "provider": "infisical",
              "id": "weather_token"
            },
            "economics": {
              "source": "exec",
              "provider": "infisical",
              "id": "economics_token"
            },
            "crypto": {
              "source": "exec",
              "provider": "infisical",
              "id": "crypto_token"
            },
            "sports": {
              "source": "exec",
              "provider": "infisical",
              "id": "sports_token"
            },
            "politics": {
              "source": "exec",
              "provider": "infisical",
              "id": "politics_token"
            },
            "entertainment": {
              "source": "exec",
              "provider": "infisical",
              "id": "entertainment_token"
            },
            "financial": {
              "source": "exec",
              "provider": "infisical",
              "id": "financial_token"
            },
            "world": {
              "source": "exec",
              "provider": "infisical",
              "id": "world_token"
            },
            "other": {
              "source": "exec",
              "provider": "infisical",
              "id": "other_token"
            },
            "sysadmin": {
              "source": "exec",
              "provider": "infisical",
              "id": "sysadmin_token"
            },
            "dev-liaison": {
              "source": "exec",
              "provider": "infisical",
              "id": "dev-liaison_token"
            }
          }
        }
      }
    }
  },
  "secrets": {
    "providers": {
      "infisical": {
        "source": "exec",
        "command": "/usr/local/bin/openclaw-infisical-resolver",
        "args": [],
        "passEnv": [
          "INFISICAL_TOKEN",
          "INFISICAL_DOMAIN"
        ],
        "jsonOnly": true
      }
    }
  },
  "mcp": {
    "servers": {
      "traderbot": {
        "url": "http://127.0.0.1:8765/mcp",
        "transport": "streamable-http",
        "requestTimeoutMs": 30000,
        "connectionTimeoutMs": 5000
      }
    }
  }
}
