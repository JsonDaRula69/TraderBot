{
  "id": "dev-liaison",
  "sandbox": {
    "mode": "all",
    "workspaceAccess": "none",
    "docker": {
      "image": "traderbot-sandbox:DEPLOY_DERIVED",
      "binds": [
        "<agent-workspace>:/workspace:ro",
        "<traderbot-data-root>/{mode}-dev-liaison:/data:rw"
      ],
      "readOnlyRoot": true,
      "network": "none",
      "user": "1000:1000",
      "capDrop": ["ALL"],
      "dangerouslyAllowExternalBindSources": true,
      "dangerouslyAllowReservedContainerTargets": true
    }
  },
  "tools": {
    "allow": [
      "traderbot__health",
      "traderbot__auth_check",
      "traderbot__profile_list",
      "sessions_spawn",
      "sessions_send",
      "sessions_yield",
      "sessions_list",
      "sessions_history",
      "subagents"
    ],
    "deny": [
      "group:runtime",
      "group:fs"
    ],
    "sandbox": {
      "tools": {
        "allow": [
          "bundle-mcp",
          "sessions_spawn",
          "sessions_send",
          "sessions_yield",
          "sessions_list",
          "sessions_history",
          "subagents"
        ]
      }
    }
  }
}
