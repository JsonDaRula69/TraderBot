{
  "id": "financial",
  "sandbox": {
    "mode": "all",
    "workspaceAccess": "none",
    "docker": {
      "image": "traderbot-sandbox:DEPLOY_DERIVED",
      "binds": [
        "<agent-workspace>:/workspace:ro",
        "<traderbot-data-root>/{mode}-financial:/data:rw"
      ],
      "readOnlyRoot": true,
      "network": "none",
      "user": "1000:1000",
      "capDrop": ["ALL"],
      "dangerouslyAllowExternalBindSources": true,
      "dangerouslyAllowReservedContainerTargets": true
    }
  },
  "tools": {
    "allow": [
      "traderbot__health",
      "traderbot__auth_check",
      "traderbot__profile_list",
      "traderbot__market_edge",
      "traderbot__market_prices"
    ],
    "deny": ["group:runtime", "group:fs"],
    "sandbox": { "tools": { "allow": ["bundle-mcp"] } }
  }
}
