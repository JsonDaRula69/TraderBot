# TraderBot Data Backfill Systemd Timer
#
# Triggers traderbot-backfill-data@.service daily to keep ChromaDB's
# data_points collection continuously enriched with fresh historical
# weather (Open-Meteo), economic (FRED), and crypto (CoinGecko) data.
#
# OnCalendar=daily → once per day, just after midnight
# RandomizedDelaySec=900 → spreads across 15 min window to avoid thundering herd
# Persistent=true → catches up after downtime
#
# USAGE:
#   sudo cp traderbot-backfill-data@.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now traderbot-backfill-data@<user>.timer

[Unit]
Description=TraderBot Data Backfill Timer (%i)
Documentation=https://github.com/JsonDaRula69/TraderBot

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
