[Unit]
Description=TraderBot Kalshi WebSocket Daemon
Documentation=https://github.com/JsonDaRula69/TraderBot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/traderbot/.venv/bin/python3 -m traderbot.kalshi.ws_daemon
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=10
Environment=PYTHONPATH=%h/traderbot/src
Environment=HOME=%h

[Install]
WantedBy=default.target